<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ISP Manager Group -->
        <record id="group_isp_manager" model="res.groups">
            <field name="name">ISP Manager</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ISP User Group -->
        <record id="group_isp_user" model="res.groups">
            <field name="name">ISP User</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ISP Technician Group -->
        <record id="group_isp_technician" model="res.groups">
            <field name="name">ISP Technician</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <!-- Record Rules -->
    <data noupdate="1">
        <!-- Default access rule for ISP records -->
        <record id="isp_billing_rule_all" model="ir.rule">
            <field name="name">ISP Billing: All Records</field>
            <field name="model_id" ref="model_isp_cpe"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager'))]"/>
        </record>
    </data>
</odoo> 