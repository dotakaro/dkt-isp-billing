<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_isp_invoice_all" model="ir.actions.act_window">
        <field name="name">Invoice Langganan</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('subscription_id', '!=', False), ('isp_invoice_kind', '!=', 'installation')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_isp_invoice_kind': 'subscription'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada invoice langganan
            </p>
        </field>
    </record>

    <record id="action_isp_invoice_draft" model="ir.actions.act_window">
        <field name="name">Draft Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'draft'), ('subscription_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada draft invoice
            </p>
        </field>
    </record>

    <record id="action_isp_invoice_posted" model="ir.actions.act_window">
        <field name="name">Posted Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('subscription_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada posted invoice
            </p>
        </field>
    </record>

    <record id="action_isp_invoice_outstanding" model="ir.actions.act_window">
        <field name="name">Belum lunas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('subscription_id', '!=', False), ('isp_invoice_kind', '!=', 'installation'), ('state', '=', 'posted'), ('amount_residual', '>', 0), ('payment_state', 'in', ['not_paid', 'partial', 'in_payment'])]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tidak ada tagihan langganan yang masih nunggak
            </p>
        </field>
    </record>

    <record id="action_isp_installation_invoice" model="ir.actions.act_window">
        <field name="name">Invoice Instalasi</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">['|', ('isp_invoice_kind', '=', 'installation'), ('invoice_line_ids.name', 'ilike', 'Biaya Instalasi')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_isp_invoice_kind': 'installation'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada invoice instalasi
            </p>
        </field>
    </record>

    <record id="action_isp_notification_queue" model="ir.actions.act_window">
        <field name="name">Antrian pemberitahuan</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0), '|', ('isp_notif_prepared', '=', True), ('category_id.name', 'in', ['notif_siap', 'notif_otomatis'])]</field>
        <field name="context">{'default_customer_rank': 1, 'res_partner_search_mode': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada antrian pemberitahuan. Tag saja, belum dikirim.
            </p>
        </field>
    </record>

    <record id="action_isp_payment" model="ir.actions.act_window">
        <field name="name">Pembayaran Pelanggan</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_partner_type': 'customer', 'default_payment_type': 'inbound'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada pembayaran pelanggan
            </p>
        </field>
    </record>

    <record id="view_isp_out_invoice_tree" model="ir.ui.view">
        <field name="name">account.out.invoice.list.isp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="subscription_id" optional="show"/>
                <field name="isp_invoice_kind" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_isp_account_move_form" model="ir.ui.view">
        <field name="name">account.move.form.isp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="isp_submitter_only" invisible="1"/>
                <button name="action_isp_pay_cash" type="object"
                        string="Bayar tunai / Kas"
                        class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state == 'paid'"/>
                <button name="action_isp_upload_proof" type="object"
                        string="Unggah bukti transfer"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state == 'paid'"/>
                <button name="action_isp_copy_upload_link" type="object"
                        string="Salin tautan unggah"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible">state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or invoice_has_outstanding or isp_submitter_only</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible">state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or not invoice_has_outstanding or isp_submitter_only</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="after">
                <field name="subscription_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       domain="[('partner_id', '=', partner_id)]"/>
                <field name="isp_invoice_kind" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="isp_upload_url" widget="CopyClipboardChar"
                       invisible="move_type != 'out_invoice' or state != 'posted'"/>
                <field name="isp_upload_token" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>

