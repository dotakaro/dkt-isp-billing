<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="res_groups_privilege_isp" model="res.groups.privilege">
            <field name="name">ISP Billing</field>
            <field name="sequence">85</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_isp_manager" model="res.groups">
            <field name="name">ISP Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_isp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Akses penuh konfigurasi ISP, paket, dan router.</field>
        </record>

        <record id="group_isp_user" model="res.groups">
            <field name="name">ISP User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_isp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Operasional harian pelanggan dan tagihan.</field>
        </record>

        <record id="group_isp_technician" model="res.groups">
            <field name="name">ISP Technician</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_isp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Teknisi lapangan: CPE dan instalasi.</field>
        </record>

        <record id="group_isp_village_admin" model="res.groups">
            <field name="name">Admin Desa</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="res_groups_privilege_isp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Unggah bukti + ajukan antrian di area sendiri. Tidak verifikasi, tidak post lunas, tanpa Settings/token WA.</field>
        </record>

        <record id="group_isp_collector" model="res.groups">
            <field name="name">Kolektor</field>
            <field name="sequence">16</field>
            <field name="privilege_id" ref="res_groups_privilege_isp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Sama seperti Admin Desa untuk pembayaran: unggah/ajukan kas atau transfer di area sendiri. Tidak verifikasi.</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="isp_billing_rule_all" model="ir.rule">
            <field name="name">ISP Billing: All Records</field>
            <field name="model_id" ref="model_isp_cpe"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager'))]"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="rule_village_admin_partner" model="ir.rule">
            <field name="name">Admin Desa: pelanggan area</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', '|', ('id', '=', user.partner_id.id), ('customer_rank', '=', 0), ('area_id', 'in', user.isp_area_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_manager_partner_all" model="ir.rule">
            <field name="name">ISP Manager: semua partner</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager')), (4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_village_admin_cpe" model="ir.rule">
            <field name="name">Admin Desa: CPE area</field>
            <field name="model_id" ref="model_isp_cpe"/>
            <field name="domain_force">['|', ('area_id', 'in', user.isp_area_ids.ids), ('partner_id.area_id', 'in', user.isp_area_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_isp_user_cpe_all" model="ir.rule">
            <field name="name">ISP User: semua CPE</field>
            <field name="model_id" ref="model_isp_cpe"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_village_admin_subscription" model="ir.rule">
            <field name="name">Admin Desa: langganan area</field>
            <field name="model_id" ref="model_isp_subscription"/>
            <field name="domain_force">['|', ('area_id', 'in', user.isp_area_ids.ids), ('partner_id.area_id', 'in', user.isp_area_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_isp_staff_subscription_all" model="ir.rule">
            <field name="name">ISP staf: semua langganan</field>
            <field name="model_id" ref="model_isp_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager')), (4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_village_admin_invoice" model="ir.rule">
            <field name="name">Admin Desa: invoice area</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">['|', ('partner_id.area_id', 'in', user.isp_area_ids.ids), ('partner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_isp_staff_invoice_all" model="ir.rule">
            <field name="name">ISP staf: semua invoice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager')), (4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_village_admin_payment" model="ir.rule">
            <field name="name">Admin Desa: pembayaran area</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">['|', ('partner_id.area_id', 'in', user.isp_area_ids.ids), ('partner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_isp_staff_payment_all" model="ir.rule">
            <field name="name">ISP staf: semua pembayaran</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager')), (4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_village_admin_proof" model="ir.rule">
            <field name="name">Admin Desa: bukti transfer area</field>
            <field name="model_id" ref="model_isp_payment_proof"/>
            <field name="domain_force">['|', '|', '|', ('area_id', 'in', user.isp_area_ids.ids), ('partner_id.area_id', 'in', user.isp_area_ids.ids), '&amp;', ('partner_id', '=', False), ('create_uid', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_isp_village_admin')), (4, ref('group_isp_collector'))]"/>
        </record>
        <record id="rule_isp_staff_proof_all" model="ir.rule">
            <field name="name">ISP staf: semua bukti transfer</field>
            <field name="model_id" ref="model_isp_payment_proof"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_isp_manager')), (4, ref('group_isp_user')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
