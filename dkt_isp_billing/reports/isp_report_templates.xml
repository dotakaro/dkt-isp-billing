<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Report Template -->
    <template id="report_customer_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Laporan Pelanggan</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>ID Pelanggan</th>
                            <th>Nama</th>
                            <th>No KTP</th>
                            <th>No HP</th>
                            <th>Alamat</th>
                            <th>Paket</th>
                            <th>Status</th>
                            <th>Tanggal Registrasi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="customers">
                            <t t-foreach="customers" t-as="customer">
                                <tr>
                                    <td><t t-esc="customer.id or ''"/></td>
                                    <td><t t-esc="customer.name or ''"/></td>
                                    <td><t t-esc="customer.identity_number or ''"/></td>
                                    <td><t t-esc="customer.mobile or ''"/></td>
                                    <td><t t-esc="customer.street or ''"/></td>
                                    <td><t t-esc="', '.join(customer.subscription_ids.filtered(lambda s: s.state == 'open').mapped('package_id.name'))"/></td>
                                    <td><t t-esc="customer.state or ''"/></td>
                                    <td><t t-esc="customer.create_date" t-options='{"widget": "date"}'/></td>
                                </tr>
                            </t>
                        </t>
                        <t t-if="not customers">
                            <tr>
                                <td colspan="8" class="text-center">Tidak ada data pelanggan</td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_customer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_customer_document">
                    <t t-set="company" t-value="doc.env.company"/>
                </t>
            </t>
        </t>
    </template>

    <!-- CPE Report Template -->
    <template id="report_cpe_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Laporan CPE</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Pelanggan</th>
                            <th>Perangkat</th>
                            <th>MAC Address</th>
                            <th>IP Address</th>
                            <th>PPPoE Username</th>
                            <th>Status</th>
                            <th>Kepemilikan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="cpes" t-as="cpe">
                            <tr>
                                <td><t t-esc="cpe.partner_id.name"/></td>
                                <td><t t-esc="cpe.name"/></td>
                                <td><t t-esc="cpe.mac_address"/></td>
                                <td><t t-esc="cpe.ip_address"/></td>
                                <td><t t-esc="cpe.pppoe_username"/></td>
                                <td><t t-esc="cpe.state"/></td>
                                <td><t t-esc="cpe.ownership"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_cpe">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_cpe_document"/>
            </t>
        </t>
    </template>

    <!-- Package Report Template -->
    <template id="report_package_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="currency" t-value="doc.env.company.currency_id"/>
                <h2>Laporan Paket Layanan</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nama Paket</th>
                            <th>Harga</th>
                            <th>Upload Speed</th>
                            <th>Download Speed</th>
                            <th>Jumlah Pelanggan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="packages" t-as="package">
                            <tr>
                                <td><t t-esc="package.name"/></td>
                                <td><t t-esc="package.price" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                <td><t t-esc="package.bandwidth_up"/> Mbps</td>
                                <td><t t-esc="package.bandwidth_down"/> Mbps</td>
                                <td><t t-esc="len(package.subscription_ids.filtered(lambda s: s.state == 'open'))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_package">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_package_document"/>
            </t>
        </t>
    </template>

    <!-- Financial Report Template -->
    <template id="report_financial_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="currency" t-value="doc.env.company.currency_id"/>
                <h2>Laporan Keuangan</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                
                <!-- Pendapatan Berlangganan -->
                <h4>Pendapatan Berlangganan</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Tanggal Invoice</th>
                            <th>Pelanggan</th>
                            <th>Paket</th>
                            <th>Jumlah</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="subscriptions">
                            <t t-foreach="subscriptions" t-as="sub">
                                <tr>
                                    <td>
                                        <t t-set="filtered_invoice" t-value="sub.invoice_ids.filtered(lambda i: i.invoice_date and (i.invoice_date &gt;= doc.date_from) and (i.invoice_date &lt;= doc.date_to))"/>
                                        <t t-if="filtered_invoice">
                                            <t t-esc="filtered_invoice[0].invoice_date" t-options='{"widget": "date"}'/>
                                        </t>
                                    </td>
                                    <td><t t-esc="sub.partner_id.name"/></td>
                                    <td><t t-esc="sub.package_id.name"/></td>
                                    <td><t t-esc="sub.final_amount" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td><t t-esc="sub.state"/></td>
                                </tr>
                            </t>
                        </t>
                        <t t-if="not subscriptions">
                            <tr>
                                <td colspan="5" class="text-center">Tidak ada data subscription</td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-right"><strong>Total Pendapatan Berlangganan</strong></td>
                            <td><strong t-esc="total_subscription" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Pendapatan Instalasi -->
                <h4>Pendapatan Instalasi</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>No. Invoice</th>
                            <th>Pelanggan</th>
                            <th>Jenis Instalasi</th>
                            <th>Jumlah</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="installations">
                            <t t-foreach="installations" t-as="inst">
                                <tr>
                                    <td><t t-esc="inst.date" t-options='{"widget": "date"}'/></td>
                                    <td><t t-esc="inst.name"/></td>
                                    <td><t t-esc="inst.partner_id.name"/></td>
                                    <td><t t-esc="inst.installation_type_id.name"/></td>
                                    <td><t t-esc="inst.amount" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td><t t-esc="inst.state"/></td>
                                </tr>
                            </t>
                        </t>
                        <t t-if="not installations">
                            <tr>
                                <td colspan="6" class="text-center">Tidak ada data instalasi</td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-right"><strong>Total Pendapatan Instalasi</strong></td>
                            <td><strong t-esc="total_installation" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Total Keseluruhan -->
                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="border-black">
                                <td><strong>Total Pendapatan</strong></td>
                                <td class="text-right">
                                    <strong t-esc="total_subscription + total_installation" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_financial_document"/>
            </t>
        </t>
    </template>

    <!-- Profit Loss Report Template -->
    <template id="report_profit_loss_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="currency" t-value="doc.env.company.currency_id"/>
                <h2>Laporan Laba Rugi</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>

                <!-- Pendapatan -->
                <h4>Pendapatan</h4>
                <table class="table table-sm">
                    <tr>
                        <td>Pendapatan Berlangganan</td>
                        <td class="text-right"><span t-esc="total_subscription" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                    </tr>
                    <tr>
                        <td>Pendapatan Instalasi</td>
                        <td class="text-right"><span t-esc="total_installation" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                    </tr>
                    <tr class="border-black">
                        <td><strong>Total Pendapatan</strong></td>
                        <td class="text-right">
                            <strong t-esc="total_revenue" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                </table>

                <!-- Biaya -->
                <h4>Biaya Operasional</h4>
                <table class="table table-sm">
                    <tr>
                        <td>Biaya Perangkat</td>
                        <td class="text-right"><span t-esc="total_device_cost" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                    </tr>
                    <tr>
                        <td>Biaya Maintenance</td>
                        <td class="text-right"><span t-esc="total_maintenance" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                    </tr>
                    <tr class="border-black">
                        <td><strong>Total Biaya</strong></td>
                        <td class="text-right">
                            <strong t-esc="total_cost" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                </table>

                <!-- Laba/Rugi -->
                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="border-black">
                                <td><strong>Laba/Rugi Bersih</strong></td>
                                <td class="text-right">
                                    <strong t-esc="total_revenue - total_cost" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_profit_loss">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_profit_loss_document"/>
            </t>
        </t>
    </template>

    <!-- Report Actions -->
    <record id="action_report_customer" model="ir.actions.report">
        <field name="name">Laporan Pelanggan</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_customer</field>
        <field name="report_file">dkt_isp_billing.report_customer</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_cpe" model="ir.actions.report">
        <field name="name">Laporan CPE</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_cpe</field>
        <field name="report_file">dkt_isp_billing.report_cpe</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_package" model="ir.actions.report">
        <field name="name">Laporan Paket</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_package</field>
        <field name="report_file">dkt_isp_billing.report_package</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_financial" model="ir.actions.report">
        <field name="name">Laporan Keuangan</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_financial</field>
        <field name="report_file">dkt_isp_billing.report_financial</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_profit_loss" model="ir.actions.report">
        <field name="name">Laporan Laba Rugi</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_profit_loss</field>
        <field name="report_file">dkt_isp_billing.report_profit_loss</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo> 