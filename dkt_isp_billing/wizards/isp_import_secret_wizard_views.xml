        <field name="name">isp.import.secret.wizard.form</field>
        <field name="model">isp.import.secret.wizard</field>
        <field name="arch" type="xml">
            <form string="Hasil import secret" create="false" edit="false">
                <group>
                    <group>
                        <field name="created_count"/>
                        <field name="updated_count"/>
                    </group>
                    <group>
                        <field name="skipped_count"/>
                        <field name="error_count"/>
                    </group>
                </group>
                <group string="Rincian">
                    <field name="log" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button string="Tutup" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
