<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action untuk menampilkan pelanggan -->
    <record id="action_isp_customer" model="ir.actions.act_window">
        <field name="name">Pelanggan</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{
            'default_customer_rank': 1,
            'search_default_customer': 1,
            'res_partner_search_mode': 'customer',
            'form_view_ref': 'dkt_isp_billing.view_isp_customer_form',
            'default_active_tab': 'isp'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat pelanggan baru
            </p>
        </field>
    </record>
    
    <!-- Tree View -->
    <record id="view_isp_customer_tree" model="ir.ui.view">
        <field name="name">res.partner.isp.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Pelanggan">
                <field name="name"/>
                <field name="street"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="subscription_count"/>
                <field name="cpe_count"/>
                <field name="total_outstanding"/>
                <field name="state"/>
                <button name="%(dkt_isp_billing.action_isp_installation_wizard)d" 
                        string="Pasang Baru" 
                        type="action" 
                        icon="fa-plug"
                        context="{'default_is_new_customer': False, 'default_partner_id': active_id}"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View - Inheritance -->
    <record id="view_isp_customer_form" model="ir.ui.view">
        <field name="name">res.partner.isp.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_activate" 
                            string="Aktifkan" 
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_enable" 
                            string="Buka Isolir" 
                            type="object"
                            class="btn-success"
                            invisible="state != 'isolated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subscriptions" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-list"
                        context="{'search_default_open': 1}">
                    <field name="subscription_count" widget="statinfo" string="Langganan"/>
                </button>
                <button name="action_view_cpe" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-sitemap"
                        context="{'search_default_open': 1}">
                    <field name="cpe_count" widget="statinfo" string="CPE"/>
                </button>
                <button name="action_view_invoices" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-money"
                        context="{'search_default_open': 1}">
                    <field name="total_outstanding" widget="statinfo" string="Tagihan"/>
                </button>
            </xpath>
            
            <xpath expr="//field[@name='duplicated_bank_account_partners_count']" position="after">
                <field name="emergency_contact" invisible="1"/>
                <field name="emergency_phone" invisible="1"/>
                <field name="notes" invisible="1"/>
            </xpath>
            
            <xpath expr="//notebook/page[1]" position="before">
                <page string="ISP" name="isp" data-section="isp" data-default-active="1">
                    <group>
                        <group string="Informasi ISP">
                            <field name="subscription_count"/>
                            <field name="cpe_count"/>
                            <field name="total_outstanding"/>
                        </group>
                        <group string="Kontak Darurat">
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes" nolabel="1"/>
                    </group>
                </page>
                <page string="CPE" name="cpe">
                    <field name="cpe_ids" context="{'default_partner_id': active_id}">
                        <tree>
                            <field name="name"/>
                            <field name="mac_address"/>
                            <field name="ip_address"/>
                            <field name="connection_type"/>
                            <field name="pppoe_username"/>
                            <field name="mikrotik_config_id"/>
                            <field name="pppoe_status"/>
                            <field name="state"/>
                            <button name="action_activate" 
                                    string="Aktifkan" 
                                    type="object"
                                    icon="fa-play"
                                    invisible="state != 'draft'"/>
                            <button name="action_isolate" 
                                    string="Isolir" 
                                    type="object"
                                    icon="fa-pause"
                                    invisible="state != 'open'"/>
                            <button name="action_enable" 
                                    string="Buka Isolir" 
                                    type="object"
                                    icon="fa-play-circle"
                                    invisible="state != 'isolated'"/>
                            <button name="action_terminate" 
                                    string="Terminasi" 
                                    type="object"
                                    icon="fa-stop"
                                    invisible="state not in ('open', 'isolated')"/>
                        </tree>
                    </field>
                    <div class="oe_right oe_button_box" name="cpe_buttons">
                        <button name="%(dkt_isp_billing.action_isp_cpe)d" 
                                type="action" 
                                class="btn btn-primary"
                                string="Tambah CPE Baru"
                                context="{'default_partner_id': active_id}"/>
                    </div>
                </page>
            </xpath>
            
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- View untuk menghilangkan tombol subscription bawaan Odoo -->
    <record id="view_partner_hide_subscription_button" model="ir.ui.view">
        <field name="name">res.partner.hide.subscription.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale_subscription.res_partner_view_inherit_sale_subscription"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_related_subscription']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_isp_customer_search" model="ir.ui.view">
        <field name="name">res.partner.isp.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Cari Pelanggan">
                <field name="name"/>
                <field name="street"/>
                <field name="mobile"/>
                <field name="email"/>
                <separator/>
                <filter string="Aktif" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Non-Aktif" name="inactive" domain="[('state', '=', 'inactive')]"/>
                <filter string="Terisolir" name="isolated" domain="[('state', '=', 'isolated')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo> 