<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence untuk Subscription -->
    <record id="seq_isp_subscription" model="ir.sequence">
        <field name="name">ISP Subscription Sequence</field>
        <field name="code">isp.subscription.sequence</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <!-- Sequence untuk Installation Fee -->
    <record id="seq_isp_installation_fee" model="ir.sequence">
        <field name="name">ISP Installation Fee Sequence</field>
        <field name="code">isp.installation.fee.sequence</field>
        <field name="prefix">INST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <!-- Sequence untuk Device History -->
    <record id="seq_isp_device_history" model="ir.sequence">
        <field name="name">ISP Device History Sequence</field>
        <field name="code">isp.device.history.sequence</field>
        <field name="prefix">DEV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_isp_payment_proof" model="ir.sequence">
        <field name="name">ISP Payment Proof</field>
        <field name="code">isp.payment.proof</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_isp_whatsapp_message" model="ir.sequence">
        <field name="name">ISP WhatsApp Message</field>
        <field name="code">isp.whatsapp.message</field>
        <field name="prefix">WA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_isp_wa_registration" model="ir.sequence">
        <field name="name">ISP WA Registration</field>
        <field name="code">isp.wa.registration</field>
        <field name="prefix">REG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo> 