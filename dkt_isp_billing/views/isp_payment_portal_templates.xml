<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_invoice_upload_proof" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="after">
            <div class="mt-3" t-if="invoice.move_type == 'out_invoice'">
                <h6 class="text-muted">Bukti transfer</h6>
                <p class="small text-muted mb-2">
                    Unggah screenshot transfer. Admin pusat yang memverifikasi.
                    Unggah ini belum membuat tagihan lunas.
                </p>
                <t t-if="request.params.get('isp_upload_ok')">
                    <div class="alert alert-success py-2">Bukti masuk antrian verifikasi.</div>
                </t>
                <t t-if="request.params.get('isp_upload_error')">
                    <div class="alert alert-warning py-2">Unggah gagal. Periksa file lalu coba lagi.</div>
                </t>
                <form t-if="isp_can_upload"
                      t-att-action="'/my/invoices/%s/isp_upload' % invoice.id"
                      method="post"
                      enctype="multipart/form-data"
                      class="d-flex flex-column gap-2">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="access_token" t-att-value="invoice.access_token"/>
                    <input type="file" name="isp_proof" accept="image/*,.pdf" class="form-control" required="required"/>
                    <button type="submit" class="btn btn-primary">Unggah bukti transfer</button>
                </form>
                <a t-if="not isp_can_upload and isp_public_upload_url and invoice.payment_state in ('not_paid', 'partial', 'in_payment')"
                   class="btn btn-primary"
                   t-att-href="isp_public_upload_url">Unggah tanpa login</a>
                <ul class="list-unstyled small mt-2 mb-0" t-if="isp_proofs">
                    <t t-foreach="isp_proofs" t-as="proof">
                        <li>
                            <t t-esc="proof.name"/> —
                            <t t-esc="dict(proof._fields['state'].selection).get(proof.state)"/>
                        </li>
                    </t>
                </ul>
            </div>
        </xpath>
    </template>
</odoo>
