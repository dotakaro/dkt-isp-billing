<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product Category for ISP Services -->
        <record id="product_category_isp_service" model="product.category">
            <field name="name">ISP Services</field>
            <field name="complete_name">ISP Services</field>
            <field name="property_account_income_categ_id" ref="revenue_account"/>
            <field name="property_account_expense_categ_id" ref="expense_account"/>
        </record>

        <!-- Product Category for ISP Equipment -->
        <record id="product_category_isp_equipment" model="product.category">
            <field name="name">ISP Equipment</field>
            <field name="complete_name">ISP Equipment</field>
            <field name="property_account_income_categ_id" ref="revenue_account"/>
            <field name="property_account_expense_categ_id" ref="expense_account"/>
        </record>

        <!-- UoM Category for Bandwidth -->
        <record id="uom_categ_bandwidth" model="uom.category">
            <field name="name">Bandwidth</field>
        </record>

        <!-- UoM for Mbps -->
        <record id="uom_mbps" model="uom.uom">
            <field name="name">Mbps</field>
            <field name="category_id" ref="uom_categ_bandwidth"/>
            <field name="uom_type">reference</field>
            <field name="rounding">0.01</field>
        </record>

        <!-- Subscription Plans -->
        <record id="monthly_subscription_plan" model="sale.subscription.plan">
            <field name="name">Monthly</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">month</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="yearly_subscription_plan" model="sale.subscription.plan">
            <field name="name">Yearly</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">year</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Subscription Pricing -->
        <record id="monthly_subscription_pricing" model="sale.subscription.pricing">
            <field name="price">0.0</field>
            <field name="plan_id" ref="monthly_subscription_plan"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="yearly_subscription_pricing" model="sale.subscription.pricing">
            <field name="price">0.0</field>
            <field name="plan_id" ref="yearly_subscription_plan"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Default Product Template for Internet Service -->
        <record id="product_template_internet_service" model="product.template">
            <field name="name">Internet Service</field>
            <field name="categ_id" ref="product_category_isp_service"/>
            <field name="detailed_type">service</field>
            <field name="uom_id" ref="dkt_isp_billing.uom_mbps"/>
            <field name="uom_po_id" ref="dkt_isp_billing.uom_mbps"/>
            <field name="default_code">ISP-SVC</field>
            <field name="sale_ok">true</field>
            <field name="purchase_ok">false</field>
            <field name="list_price">0.0</field>
            <field name="recurring_invoice">true</field>
            <field name="product_subscription_pricing_ids" eval="[(6, 0, [ref('monthly_subscription_pricing'), ref('yearly_subscription_pricing')])]"/>
            <field name="property_account_income_id" ref="revenue_account"/>
            <field name="property_account_expense_id" ref="expense_account"/>
        </record>

        <!-- Default Product Template for CPE Equipment -->
        <record id="product_template_cpe_equipment" model="product.template">
            <field name="name">CPE Equipment</field>
            <field name="categ_id" ref="product_category_isp_equipment"/>
            <field name="detailed_type">consu</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="default_code">ISP-CPE</field>
            <field name="sale_ok">true</field>
            <field name="purchase_ok">true</field>
            <field name="list_price">0.0</field>
            <field name="property_account_income_id" ref="revenue_account"/>
            <field name="property_account_expense_id" ref="expense_account"/>
        </record>
    </data>
</odoo> 