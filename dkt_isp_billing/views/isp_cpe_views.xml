<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_isp_cpe_tree" model="ir.ui.view">
        <field name="name">isp.cpe.tree</field>
        <field name="model">isp.cpe</field>
        <field name="arch" type="xml">
            <list string="CPE" js_class="isp_cpe_list"
                  decoration-danger="pppoe_status == 'disconnected'"
                  decoration-warning="pppoe_status != 'disconnected' and (is_multisession or state == 'isolated')"
                  decoration-success="state == 'open' and pppoe_status != 'disconnected' and not is_multisession"
                  decoration-muted="state == 'terminated'">
                <header>
                    <button name="action_refresh_list_status"
                            type="object"
                            string="Refresh status"
                            class="btn-secondary"
                            display="always"/>
                    <button name="action_open_isolate_bulk"
                            type="object"
                            string="Isolir massal"/>
                    <button name="action_open_parse_phone"
                            type="object"
                            string="Parse nomor dari secret"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mac_address"/>
                <field name="ip_address"/>
                <field name="pppoe_username"/>
                <field name="area_id" optional="show"/>
                <field name="mikrotik_config_id" optional="show"/>
                <field name="pppoe_status"/>
                <field name="pppoe_session_count" string="Sesi"/>
                <field name="is_multisession" column_invisible="1"/>
                <field name="pppoe_uptime"/>
                <field name="upload_usage" sum="Total Upload"/>
                <field name="download_usage" sum="Total Download"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_isp_cpe_form" model="ir.ui.view">
        <field name="name">isp.cpe.form</field>
        <field name="model">isp.cpe</field>
        <field name="arch" type="xml">
            <form string="CPE">
                <header>
                    <button name="action_activate" 
                            string="Aktifkan" 
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_isolate" 
                            string="Isolir" 
                            type="object"
                            invisible="state != 'open'"/>
                    <button name="action_enable" 
                            string="Buka Isolir" 
                            type="object"
                            class="btn-success"
                            invisible="state != 'isolated'"/>
                    <button name="action_terminate" 
                            string="Terminasi" 
                            type="object"
                            invisible="state not in ('open', 'isolated')"/>
                    <button name="action_check_pppoe" 
                            string="Check Status PPPoE" 
                            type="object"
                            class="btn-info"
                            invisible="connection_type != 'pppoe'"/>
                    <button name="action_start_monitoring" 
                            string="Start Monitoring" 
                            type="object"
                            class="btn-success"
                            invisible="connection_type != 'pppoe' or is_monitoring"/>
                    <button name="action_stop_monitoring" 
                            string="Stop Monitoring" 
                            type="object"
                            class="btn-danger"
                            invisible="connection_type != 'pppoe' or not is_monitoring"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pppoe_history"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="connection_type != 'pppoe'">
                            <field name="pppoe_history_count" widget="statinfo" string="Riwayat PPPoE"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nama Perangkat" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_multisession">
                        Username PPPoE ini punya lebih dari satu sesi aktif di router yang sama.
                        Toleransi: sesi extra tidak diputus. Periksa pemakaian username oleh teknisi.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="mac_address" readonly="state != 'draft'"/>
                            <field name="ip_address" readonly="state != 'draft'"/>
                            <field name="outdoor_unit" readonly="state != 'draft'"/>
                            <field name="router" readonly="state != 'draft'"/>
                            <field name="connection_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pppoe_username" invisible="connection_type != 'pppoe'" readonly="state != 'draft'"/>
                            <field name="pppoe_password" password="1" invisible="connection_type != 'pppoe'" readonly="state != 'draft'"/>
                            <field name="mikrotik_config_id" 
                                   options="{'no_create': True}" 
                                   invisible="connection_type != 'pppoe'" 
                                   domain="[('active', '=', True)]"
                                   required="connection_type == 'pppoe'"
                                   widget="selection"
                                   readonly="state != 'draft'"/>
                            <field name="area_id" readonly="1" invisible="connection_type != 'pppoe'"/>
                            <field name="ownership" readonly="state != 'draft'"/>
                            <field name="technician_user_id"/>
                            <field name="isp_onboarding"/>
                            <field name="isp_activation_revoked"/>
                            <field name="isp_evidence_waived"/>
                            <field name="isp_first_connected_at" readonly="1"/>
                            <field name="isp_evidence_deadline" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Monitoring" name="monitoring" invisible="connection_type != 'pppoe'">
                            <group>
                                <group string="Status PPPoE">
                                    <field name="pppoe_status" readonly="1"/>
                                    <field name="pppoe_session_count" readonly="1"/>
                                    <field name="is_multisession" readonly="1"/>
                                    <field name="pppoe_uptime" readonly="1"/>
                                    <field name="pppoe_last_seen" readonly="1"/>
                                    <field name="pppoe_caller_id" readonly="1"/>
                                    <field name="pppoe_caller_ids" readonly="1" invisible="pppoe_session_count &lt;= 1"/>
                                    <field name="pppoe_address" readonly="1"/>
                                    <field name="pppoe_session_id" readonly="1"/>
                                </group>
                                <group string="Penggunaan">
                                    <field name="upload_usage" readonly="1"/>
                                    <field name="download_usage" readonly="1"/>
                                    <field name="signal_strength" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Subscription" name="subscription">
                            <field name="subscription_ids" context="{'default_partner_id': partner_id, 'default_cpe_id': id}" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="package_id"/>
                                    <field name="date_start"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                    <button name="action_open" 
                                            string="Aktifkan" 
                                            type="object"
                                            icon="fa-play"
                                            invisible="state != 'draft'"/>
                                    <button name="action_isolate" 
                                            string="Isolir" 
                                            type="object"
                                            icon="fa-pause"
                                            invisible="state != 'open'"/>
                                    <button name="action_enable" 
                                            string="Buka Isolir" 
                                            type="object"
                                            icon="fa-play-circle"
                                            invisible="state != 'isolated'"/>
                                    <button name="action_terminate" 
                                            string="Terminasi" 
                                            type="object"
                                            icon="fa-stop"
                                            invisible="state not in ('open', 'isolated')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Riwayat" name="history">
                            <field name="history_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="device_name"/>
                                    <field name="replacement_reason"/>
                                    <field name="technician_id"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Riwayat PPPoE" name="pppoe_history" invisible="connection_type != 'pppoe'">
                            <field name="pppoe_history_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="timestamp"/>
                                    <field name="event_type"/>
                                    <field name="old_status"/>
                                    <field name="new_status"/>
                                    <field name="session_count"/>
                                    <field name="uptime"/>
                                    <field name="caller_id"/>
                                    <field name="ip_address"/>
                                    <field name="router_id"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="PPPoE" invisible="connection_type != 'pppoe'">
                            <group>
                                <group string="PPPoE Credentials">
                                    <field name="pppoe_username" readonly="state != 'draft'"/>
                                    <field name="pppoe_password" password="True" readonly="state != 'draft'"/>
                                    <field name="mikrotik_config_id" 
                                        options="{'no_create': True}" 
                                        domain="[('active', '=', True)]" 
                                        required="connection_type == 'pppoe'"
                                        widget="selection"
                                        readonly="state != 'draft'"/>
                                </group>
                                <group string="PPPoE Status">
                                    <field name="pppoe_status" readonly="1"/>
                                    <field name="pppoe_session_count" readonly="1"/>
                                    <field name="is_multisession" readonly="1"/>
                                    <field name="pppoe_uptime" readonly="1"/>
                                    <field name="pppoe_last_seen" readonly="1"/>
                                    <field name="pppoe_caller_id" readonly="1"/>
                                    <field name="pppoe_caller_ids" readonly="1" invisible="pppoe_session_count &lt;= 1"/>
                                    <field name="pppoe_address" readonly="1"/>
                                    <field name="pppoe_session_id" readonly="1"/>
                                </group>
                            </group>
                            <group string="Usage Statistics">
                                <group>
                                    <field name="upload_usage" widget="float_time" readonly="1"/>
                                    <field name="download_usage" widget="float_time" readonly="1"/>
                                    <field name="upload_rate" readonly="1"/>
                                    <field name="download_rate" readonly="1"/>
                                </group>
                                <group>
                                    <field name="signal_strength" readonly="1"/>
                                    <field name="is_monitoring" invisible="1"/>
                                    <button name="action_start_monitoring" 
                                            string="Start Monitoring" 
                                            type="object" 
                                            class="oe_highlight"
                                            invisible="is_monitoring"/>
                                    <button name="action_stop_monitoring" 
                                            string="Stop Monitoring" 
                                            type="object"
                                            class="oe_highlight" 
                                            invisible="not is_monitoring"/>
                                </group>
                            </group>
                            <div class="o_monitoring_container" invisible="not is_monitoring">
                                <div class="alert alert-info" role="alert">
                                    Monitoring aktif. Data akan diupdate setiap detik.
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="o_stat_info">
                                            <span class="o_stat_text">Upload Rate</span>
                                            <field name="current_upload_rate" readonly="1"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="o_stat_info">
                                            <span class="o_stat_text">Download Rate</span>
                                            <field name="current_download_rate" readonly="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_isp_cpe_search" model="ir.ui.view">
        <field name="name">isp.cpe.search</field>
        <field name="model">isp.cpe</field>
        <field name="arch" type="xml">
            <search string="CPE">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mac_address"/>
                <field name="ip_address"/>
                <field name="pppoe_username"/>
                <field name="area_id"/>
                <field name="mikrotik_config_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Terisolir" name="isolated" domain="[('state', '=', 'isolated')]"/>
                <filter string="Terminasi" name="terminated" domain="[('state', '=', 'terminated')]"/>
                <separator/>
                <filter string="Connected" name="connected" domain="[('pppoe_status', '=', 'connected')]"/>
                <filter string="Disconnected" name="disconnected" domain="[('pppoe_status', '=', 'disconnected')]"/>
                <filter string="Multi-sesi" name="multisession" domain="[('is_multisession', '=', True)]"/>
                <filter string="Pasang baru" name="onboarding" domain="[('isp_onboarding', '=', True)]"/>
                <filter string="Aktivasi dicabut eviden" name="revoked" domain="[('isp_activation_revoked', '=', True)]"/>
                <filter string="Perlu perhatian" name="need_attention" domain="[('is_multisession', '=', True)]"/>
                <group>
                    <filter string="Pelanggan" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Status PPPoE" name="group_by_pppoe" context="{'group_by': 'pppoe_status'}"/>
                    <filter string="Multi-sesi" name="group_by_multisession" context="{'group_by': 'is_multisession'}"/>
                    <filter string="Area" name="group_by_area" context="{'group_by': 'area_id'}"/>
                    <filter string="Router Mikrotik" name="group_by_mikrotik" context="{'group_by': 'mikrotik_config_id'}"/>
                </group>
                <searchpanel>
                    <field name="mikrotik_config_id"
                           string="Router MikroTik"
                           icon="fa-sitemap"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_isp_cpe" model="ir.actions.act_window">
        <field name="name">CPE</field>
        <field name="res_model">isp.cpe</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isp_cpe_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat CPE baru
            </p>
        </field>
    </record>

    <record id="action_isp_cpe_attention" model="ir.actions.act_window">
        <field name="name">Perlu perhatian</field>
        <field name="res_model">isp.cpe</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isp_cpe_search"/>
        <field name="domain">[('is_multisession', '=', True)]</field>
        <field name="context">{'search_default_multisession': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tidak ada CPE multi-sesi saat ini
            </p>
        </field>
    </record>

    <!-- Assets -->
    <record id="dkt_isp_billing_pppoe_monitor_js" model="ir.asset">
        <field name="name">PPPoE Monitor JS</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">/dkt_isp_billing/static/src/js/pppoe_monitor.js</field>
    </record>
</odoo> 