<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Report Template -->
    <template id="report_customer_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Laporan Pelanggan</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>ID Pelanggan</th>
                            <th>Nama</th>
                            <th>No KTP</th>
                            <th>No HP</th>
                            <th>Alamat</th>
                            <th>Paket</th>
                            <th>Status</th>
                            <th>Tanggal Registrasi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="customers">
                            <t t-foreach="customers" t-as="customer">
                                <tr>
                                    <td><t t-esc="customer.id or ''"/></td>
                                    <td><t t-esc="customer.name or ''"/></td>
                                    <td><t t-esc="customer.identity_number or ''"/></td>
                                    <td><t t-esc="customer.mobile or ''"/></td>
                                    <td><t t-esc="customer.street or ''"/></td>
                                    <td><t t-esc="', '.join(customer.subscription_ids.filtered(lambda s: s.state == 'open').mapped('package_id.name'))"/></td>
                                    <td><t t-esc="customer.state or ''"/></td>
                                    <td><t t-esc="customer.create_date" t-options='{"widget": "date"}'/></td>
                                </tr>
                            </t>
                        </t>
                        <t t-if="not customers">
                            <tr>
                                <td colspan="8" class="text-center">Tidak ada data pelanggan</td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_customer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_customer_document">
                    <t t-set="company" t-value="doc.env.company"/>
                </t>
            </t>
        </t>
    </template>

    <!-- CPE Report Template -->
    <template id="report_cpe_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Laporan CPE</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Pelanggan</th>
                            <th>Perangkat</th>
                            <th>MAC Address</th>
                            <th>IP Address</th>
                            <th>PPPoE Username</th>
                            <th>Status</th>
                            <th>Kepemilikan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="cpes" t-as="cpe">
                            <tr>
                                <td><t t-esc="cpe.partner_id.name"/></td>
                                <td><t t-esc="cpe.name"/></td>
                                <td><t t-esc="cpe.mac_address"/></td>
                                <td><t t-esc="cpe.ip_address"/></td>
                                <td><t t-esc="cpe.pppoe_username"/></td>
                                <td><t t-esc="cpe.state"/></td>
                                <td><t t-esc="cpe.ownership"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_cpe">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_cpe_document"/>
            </t>
        </t>
    </template>

    <!-- Package Report Template -->
    <template id="report_package_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="currency" t-value="doc.env.company.currency_id"/>
                <h2>Laporan Paket Layanan</h2>
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p><span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/></p>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nama Paket</th>
                            <th>Harga</th>
                            <th>Upload Speed</th>
                            <th>Download Speed</th>
                            <th>Jumlah Pelanggan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="packages" t-as="package">
                            <tr>
                                <td><t t-esc="package.name"/></td>
                                <td><t t-esc="package.price" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                <td><t t-esc="package.bandwidth_up"/> Mbps</td>
                                <td><t t-esc="package.bandwidth_down"/> Mbps</td>
                                <td><t t-esc="len(package.subscription_ids.filtered(lambda s: s.state == 'open'))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_package">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dkt_isp_billing.report_package_document"/>
            </t>
        </t>
    </template>

    <!-- Financial Report Template -->
    <template id="report_financial_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div style="text-align: center; margin-bottom: 20px;">
                    <h3 style="font-weight: bold; font-size: 24px; margin-bottom: 10px;">LAPORAN KEUANGAN</h3>
                    <p style="font-size: 16px;">Periode: <span t-field="docs.date_from"/> s/d <span t-field="docs.date_to"/></p>
                </div>
                
                <!-- Pesan peringatan jika tidak ada data -->
                <div t-if="total_subscription == 0 and total_installation == 0" class="alert alert-warning" style="text-align: center; padding: 10px; margin-bottom: 20px;">
                    <strong>Peringatan:</strong> Tidak ada data keuangan untuk periode ini. Data yang ditampilkan adalah data dummy untuk keperluan testing.
                </div>
                
                <!-- Bagian Pendapatan -->
                <h4 style="font-weight: bold; margin-top: 20px; margin-bottom: 10px;">PENDAPATAN</h4>
                
                <!-- Tabel Pendapatan Berlangganan -->
                <h5 style="font-weight: bold; margin-top: 15px; margin-bottom: 10px;">Pendapatan Berlangganan</h5>
                <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 5%;">No</th>
                            <th style="width: 30%;">Pelanggan</th>
                            <th style="width: 20%;">Paket</th>
                            <th style="width: 15%;">Periode</th>
                            <th style="width: 15%;">Status</th>
                            <th style="width: 15%;">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <tr t-foreach="subscriptions" t-as="subscription">
                            <td><span t-esc="counter"/><t t-set="counter" t-value="counter+1"/></td>
                            <td><span t-field="subscription.partner_id.name"/></td>
                            <td><span t-field="subscription.package_id.name"/></td>
                            <td>
                                <t t-if="subscription.next_invoice_date">
                                    <span t-field="subscription.next_invoice_date" t-options="{'widget': 'date'}"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td><span t-field="subscription.state"/></td>
                            <td class="text-right">
                                <span t-field="subscription.final_amount" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-if="not subscriptions">
                            <td colspan="6" class="text-center">Tidak ada data pendapatan berlangganan</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Pendapatan Berlangganan:</strong></td>
                            <td class="text-right"><strong><span t-esc="total_subscription" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong></td>
                        </tr>
                    </tbody>
                </table>
                
                <!-- Tabel Pendapatan Instalasi -->
                <h5 style="font-weight: bold; margin-top: 15px; margin-bottom: 10px;">Pendapatan Instalasi</h5>
                <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 5%;">No</th>
                            <th style="width: 30%;">Pelanggan</th>
                            <th style="width: 20%;">Tipe Instalasi</th>
                            <th style="width: 15%;">Tanggal</th>
                            <th style="width: 15%;">Status</th>
                            <th style="width: 15%;">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <tr t-foreach="installations" t-as="installation">
                            <td><span t-esc="counter"/><t t-set="counter" t-value="counter+1"/></td>
                            <td><span t-field="installation.partner_id.name"/></td>
                            <td>
                                <t t-if="installation.installation_type_id">
                                    <span t-field="installation.installation_type_id.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td><span t-field="installation.date" t-options="{'widget': 'date'}"/></td>
                            <td><span t-field="installation.state"/></td>
                            <td class="text-right">
                                <span t-field="installation.amount" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-if="not installations">
                            <td colspan="6" class="text-center">Tidak ada data pendapatan instalasi</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Pendapatan Instalasi:</strong></td>
                            <td class="text-right"><strong><span t-esc="total_installation" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong></td>
                        </tr>
                    </tbody>
                </table>
                
                <!-- Total Pendapatan -->
                <div class="row" style="margin-bottom: 30px;">
                    <div class="col-8"></div>
                    <div class="col-4">
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td style="width: 70%;"><strong>TOTAL PENDAPATAN:</strong></td>
                                <td style="width: 30%;" class="text-right">
                                    <strong><span t-esc="total_subscription + total_installation" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <!-- Bagian Piutang -->
                <h4 style="font-weight: bold; margin-top: 30px; margin-bottom: 10px;">PIUTANG</h4>
                
                <!-- Tabel Piutang Berlangganan -->
                <h5 style="font-weight: bold; margin-top: 15px; margin-bottom: 10px;">Piutang Berlangganan</h5>
                <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 5%;">No</th>
                            <th style="width: 30%;">Pelanggan</th>
                            <th style="width: 20%;">Paket</th>
                            <th style="width: 15%;">Periode</th>
                            <th style="width: 15%;">Status</th>
                            <th style="width: 15%;">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <tr t-foreach="subscription_receivables" t-as="subscription">
                            <td><span t-esc="counter"/><t t-set="counter" t-value="counter+1"/></td>
                            <td><span t-field="subscription.partner_id.name"/></td>
                            <td><span t-field="subscription.package_id.name"/></td>
                            <td>
                                <t t-if="subscription.next_invoice_date">
                                    <span t-field="subscription.next_invoice_date" t-options="{'widget': 'date'}"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td><span t-field="subscription.state"/></td>
                            <td class="text-right">
                                <span t-field="subscription.final_amount" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-if="not subscription_receivables">
                            <td colspan="6" class="text-center">Tidak ada data piutang berlangganan</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Piutang Berlangganan:</strong></td>
                            <td class="text-right"><strong><span t-esc="total_subscription_receivable" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong></td>
                        </tr>
                    </tbody>
                </table>
                
                <!-- Tabel Piutang Instalasi -->
                <h5 style="font-weight: bold; margin-top: 15px; margin-bottom: 10px;">Piutang Instalasi</h5>
                <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 5%;">No</th>
                            <th style="width: 30%;">Pelanggan</th>
                            <th style="width: 20%;">Tipe Instalasi</th>
                            <th style="width: 15%;">Tanggal</th>
                            <th style="width: 15%;">Status</th>
                            <th style="width: 15%;">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <tr t-foreach="installation_receivables" t-as="installation">
                            <td><span t-esc="counter"/><t t-set="counter" t-value="counter+1"/></td>
                            <td><span t-field="installation.partner_id.name"/></td>
                            <td>
                                <t t-if="installation.installation_type_id">
                                    <span t-field="installation.installation_type_id.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td><span t-field="installation.date" t-options="{'widget': 'date'}"/></td>
                            <td><span t-field="installation.state"/></td>
                            <td class="text-right">
                                <span t-field="installation.amount" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-if="not installation_receivables">
                            <td colspan="6" class="text-center">Tidak ada data piutang instalasi</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right"><strong>Total Piutang Instalasi:</strong></td>
                            <td class="text-right"><strong><span t-esc="total_installation_receivable" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong></td>
                        </tr>
                    </tbody>
                </table>
                
                <!-- Total Piutang -->
                <div class="row" style="margin-bottom: 30px;">
                    <div class="col-8"></div>
                    <div class="col-4">
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td style="width: 70%;"><strong>TOTAL PIUTANG:</strong></td>
                                <td style="width: 30%;" class="text-right">
                                    <strong><span t-esc="total_subscription_receivable + total_installation_receivable" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <!-- Catatan kaki -->
                <div t-if="total_subscription == 0 and total_installation == 0" class="alert alert-info" style="text-align: center; padding: 10px; margin-top: 30px;">
                    <small>Catatan: Data yang ditampilkan adalah data dummy untuk keperluan testing.</small>
                </div>
            </div>
        </t>
    </template>

    <template id="report_financial">
        <t t-call="web.html_container">
            <!-- Jika docs ada, gunakan foreach -->
            <t t-if="docs and len(docs) > 0">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="dkt_isp_billing.report_financial_document" t-lang="user.lang"/>
                </t>
            </t>
            <!-- Jika docs kosong, gunakan data langsung -->
            <t t-else="">
                <t t-set="doc" t-value="False"/>
                <t t-call="dkt_isp_billing.report_financial_document" t-lang="user.lang"/>
            </t>
        </t>
    </template>

    <!-- Profit Loss Report Template -->
    <template id="report_profit_loss_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-set="currency" t-value="env.company.currency_id"/>
                <h2 style="text-align: center; font-weight: bold;">LAPORAN LABA RUGI</h2>

                <!-- Tampilkan periode yang dipilih -->
                <div class="row mt32 mb32">
                    <div class="col-3">
                        <strong>Periode:</strong>
                        <p t-if="doc and doc.date_from and doc.date_to">
                            <span t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <span t-esc="doc.date_to" t-options='{"widget": "date"}'/>
                        </p>
                        <p t-if="data and data.get('form') and data['form'].get('date_from') and data['form'].get('date_to')">
                            <span t-esc="data['form']['date_from']" t-options='{"widget": "date"}'/> - <span t-esc="data['form']['date_to']" t-options='{"widget": "date"}'/>
                        </p>
                    </div>
                </div>

                <!-- Pesan peringatan jika tidak ada data -->
                <div t-if="total_revenue == 0 and total_cost == 0" class="alert alert-warning" role="alert">
                    <strong>Perhatian!</strong> Tidak ada data keuangan dalam periode yang dipilih. Nilai yang ditampilkan adalah data dummy untuk testing.
                </div>

                <!-- Pendapatan -->
                <h4 style="font-weight: bold; margin-top: 20px;">PENDAPATAN</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td>Pendapatan Berlangganan</td>
                        <td class="text-right">
                            <span t-esc="total_subscription" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr>
                        <td>Pendapatan Instalasi</td>
                        <td class="text-right">
                            <span t-esc="total_installation" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr>
                        <td>Penjualan</td>
                        <td class="text-right">
                            <span t-esc="total_sales" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr class="border-black bg-light">
                        <td><strong>Total Pendapatan</strong></td>
                        <td class="text-right">
                            <strong t-esc="total_revenue" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                </table>

                <!-- Biaya -->
                <h4 style="font-weight: bold; margin-top: 20px;">BIAYA OPERASIONAL</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td>Biaya Perangkat</td>
                        <td class="text-right">
                            <span t-esc="total_device_cost" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr>
                        <td>Biaya Maintenance</td>
                        <td class="text-right">
                            <span t-esc="total_maintenance" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr class="border-black bg-light">
                        <td><strong>Total Biaya</strong></td>
                        <td class="text-right">
                            <strong t-esc="total_cost" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                </table>

                <!-- Laba/Rugi -->
                <div class="row justify-content-end mt-4">
                    <div class="col-4">
                        <table class="table table-sm table-bordered">
                            <tr class="border-black bg-light">
                                <td><strong>LABA/RUGI BERSIH</strong></td>
                                <td class="text-right">
                                    <strong t-esc="total_revenue - total_cost" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Footer note jika data kosong -->
                <div t-if="total_revenue == 0 and total_cost == 0" class="mt-4">
                    <small class="text-muted">
                        <i>Catatan: Tidak ada data transaksi dalam periode yang dipilih. Data yang ditampilkan adalah data dummy untuk testing.</i>
                    </small>
                </div>
            </div>
        </t>
    </template>

    <template id="report_profit_loss">
        <t t-call="web.html_container">
            <!-- Jika docs ada, gunakan foreach -->
            <t t-if="docs and len(docs) > 0">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="dkt_isp_billing.report_profit_loss_document" t-lang="user.lang"/>
                </t>
            </t>
            <!-- Jika docs kosong, gunakan data langsung -->
            <t t-else="">
                <t t-set="doc" t-value="False"/>
                <t t-call="dkt_isp_billing.report_profit_loss_document" t-lang="user.lang"/>
            </t>
        </t>
    </template>

    <!-- Report Actions -->
    <record id="action_report_customer" model="ir.actions.report">
        <field name="name">Laporan Pelanggan</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_customer</field>
        <field name="report_file">dkt_isp_billing.report_customer</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_cpe" model="ir.actions.report">
        <field name="name">Laporan CPE</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_cpe</field>
        <field name="report_file">dkt_isp_billing.report_cpe</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_package" model="ir.actions.report">
        <field name="name">Laporan Paket</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dkt_isp_billing.report_package</field>
        <field name="report_file">dkt_isp_billing.report_package</field>
        <field name="binding_model_id" ref="model_isp_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_financial" model="ir.actions.report">
        <field name="name">Laporan Keuangan</field>
        <field name="model">isp.report</field>
        <field name="report_type">qweb-pdf</field>
