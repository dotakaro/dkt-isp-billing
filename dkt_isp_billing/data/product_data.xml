<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_category_isp_service" model="product.category">
            <field name="name">ISP Services</field>
        </record>
        <record id="product_category_isp_equipment" model="product.category">
            <field name="name">ISP Equipment</field>
        </record>
        <record id="product_template_internet_service" model="product.template">
            <field name="name">Internet Service</field>
            <field name="categ_id" ref="product_category_isp_service"/>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="default_code">ISP-SVC</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="recurring_invoice" eval="True"/>
        </record>
        <record id="product_template_cpe_equipment" model="product.template">
            <field name="name">CPE Equipment</field>
            <field name="categ_id" ref="product_category_isp_equipment"/>
            <field name="type">consu</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="default_code">ISP-CPE</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price">0.0</field>
        </record>
    </data>
</odoo>
