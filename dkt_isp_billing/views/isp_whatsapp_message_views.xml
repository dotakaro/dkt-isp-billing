<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isp_whatsapp_message_list" model="ir.ui.view">
        <field name="name">isp.whatsapp.message.list</field>
        <field name="model">isp.whatsapp.message</field>
        <field name="arch" type="xml">
            <list create="false" decoration-success="state == 'sent'"
                  decoration-info="state == 'dry_run'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="template_kind"/>
                <field name="provider"/>
                <field name="state"/>
                <field name="dry_run"/>
                <field name="sent_date"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_isp_whatsapp_message_form" model="ir.ui.view">
        <field name="name">isp.whatsapp.message.form</field>
        <field name="model">isp.whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Log WhatsApp" create="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dry_run,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="template_kind"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="dry_run"/>
                            <field name="sent_date"/>
                            <field name="external_id"/>
                            <field name="invoice_id"/>
                            <field name="subscription_id"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <group string="Isi">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Respons" invisible="not response_raw">
                        <field name="response_raw" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_isp_whatsapp_message_search" model="ir.ui.view">
        <field name="name">isp.whatsapp.message.search</field>
        <field name="model">isp.whatsapp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="name"/>
                <filter string="Dry-run" name="dry_run" domain="[('state', '=', 'dry_run')]"/>
                <filter string="Terkirim" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Gagal" name="failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Provider" name="group_provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isp_whatsapp_message" model="ir.actions.act_window">
        <field name="name">Log WhatsApp</field>
        <field name="res_model">isp.whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada log WhatsApp. Kirim dari menu Pemberitahuan.
            </p>
        </field>
    </record>
</odoo>
